generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum LocalityType {
  CITY
  TOWN
}
enum CompetitionType {
  LEAGUE
  CUP
  TOURNAMENT
}
enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}
model Province {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  slug         String        @unique
  isoCode      String?
  boundary     Unsupported("geometry(MultiPolygon,4326)")
  localities   Locality[]    @relation("ProvinceLocalities")
  localLeagues LocalLeague[] @relation("ProvinceLocalLeagues")

  @@index([boundary], type: Gist)
}
model Locality {
  id          String        @id @default(uuid()) @db.Uuid
  provinceId  String        @db.Uuid
  name        String
  slug        String
  type        LocalityType
  location    Unsupported("geometry(Point,4326)")
  province     Province      @relation("ProvinceLocalities", fields: [provinceId], references: [id], onDelete: Restrict)
  clubs        Club[]        @relation("LocalityClubs")
  localLeagues LocalLeague[] @relation("LocalityLocalLeagues")
  @@unique([provinceId, slug])
  @@index([provinceId])
  @@index([location], type: Gist)
}
model LocalLeague {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String   @unique
  provinceId String   @db.Uuid
  localityId String?  @db.Uuid
  organizer  String?
  logoUrl    String?
  foundation String?
  province Province @relation("ProvinceLocalLeagues", fields: [provinceId], references: [id], onDelete: Restrict)
  locality Locality? @relation("LocalityLocalLeagues", fields: [localityId], references: [id], onDelete: SetNull)
  clubs    Club[]   @relation("LocalLeagueClubs")
  @@index([provinceId])
  @@index([localityId])
}
model Club {
  id              String   @id @default(uuid()) @db.Uuid
  localityId      String   @db.Uuid
  localLeagueId   String?  @db.Uuid
  fullName        String
  shortName       String?
  slug            String   @unique
  nickname        String?
  foundation      String?
  history         String?  @db.Text
  crestUrl        String?
  stadiumName     String?
  stadiumCapacity Int?
  location        Unsupported("geometry(Point,4326)")
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  locality      Locality       @relation("LocalityClubs", fields: [localityId], references: [id], onDelete: Restrict)
  localLeague   LocalLeague?   @relation("LocalLeagueClubs", fields: [localLeagueId], references: [id], onDelete: SetNull)
  competitions  Competition[]
  titles        Title[]
  suggestions   Suggestion[]
  @@index([localityId])
  @@index([localLeagueId])
  @@index([verified])
  @@index([location], type: Gist)
}
model Competition {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  type        CompetitionType
  level       Int?
  parentId    String?         @db.Uuid
  logoUrl     String?
  foundation  String?
  parent      Competition?    @relation("CompetitionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Competition[]   @relation("CompetitionHierarchy")
  clubs       Club[]
  @@index([parentId])
  @@index([type])
}
model Title {
  id     String @id @default(uuid()) @db.Uuid
  clubId String @db.Uuid
  name   String
  count  Int    @default(1)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@unique([clubId, name])
  @@index([clubId])
}
model Suggestion {
  id        String           @id @default(uuid()) @db.Uuid
  clubId    String           @db.Uuid
  field     String
  oldValue  String
  newValue  String
  status    SuggestionStatus @default(PENDING)
  createdAt DateTime         @default(now())
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@index([clubId, status])
  @@index([createdAt])
}
